NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
ADMIN_EMAIL=your-admin-email@gmail.com

# Supabase Postgres pooler URL. Keep this server-side and never expose it in
# NEXT_PUBLIC_* variables.
DATABASE_URL=postgresql://postgres.PROJECT:STRONG_PASSWORD@POOLER_HOST:6543/postgres
DATABASE_SSL=true
DATABASE_POOL_SIZE=8

# Private directory mounted from the VPS. Never place this directory under
# public/, an Nginx document root, or another directly served location.
MEDIA_ROOT=/var/lib/lingolive/media

# Generate with: openssl rand -base64 32
MEDIA_CONFIG_ENCRYPTION_KEY=

# Optional fallback translation endpoint.
TRANSLATION_API_URL=
TRANSLATION_API_KEY=

# Application origin used by deployment checks and OAuth callbacks.
APP_ORIGIN=https://your-domain.example
